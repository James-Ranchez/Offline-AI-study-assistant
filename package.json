{
  "name": "studymind",
  "version": "1.0.0",
  "description": "Offline AI Study Assistant App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "ollama",
    "ai",
    "study",
    "offline"
  ],
  "author": "StudyMind Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.studymind.app",
    "productName": "StudyMind",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer/**/*",
      "styles/**/*",
      "assets/**/*"
    ]
  },
  "dependencies": {}
}
